# SQLite file path (relative to backend/ unless absolute)
DATABASE_URL=sqlite:///./grind.db

# Comma-separated list of origins allowed to call this API.
# Only needed because the frontend (Vite dev server / Vercel) runs on a
# different origin than this API. Keep this narrow in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional: enables the AI Coach on the Workout page. Without this, the
# app still works fully — AI endpoints just return "unavailable" and the
# objective progressive-overload engine is used instead.
# AI_API_KEY=
# AI_MODEL=claude-haiku-4-5-20251001
